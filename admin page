<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IC7 Iconic Sevens — Clan HQ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Barlow:ital,wght@0,400;0,500;0,600;1,600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-950:#070b12;
    --navy-900:#0c121d;
    --navy-800:#141d2c;
    --line:#243144;
    --cyan:#37e6d0;
    --lime:#c8ff3d;
    --ink:#eef3f7;
    --ink-dim:#8b9bb0;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:
      radial-gradient(ellipse 900px 500px at 50% -10%, rgba(55,230,208,0.14), transparent 60%),
      var(--navy-950);
    color:var(--ink);
    font-family:'Barlow',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{font-family:'Rajdhani',sans-serif;text-transform:uppercase;letter-spacing:0.02em;}
  a{color:inherit;}
  :focus-visible{outline:3px solid var(--cyan);outline-offset:3px;}

  /* Ticker */
  .ticker-wrap{
    background:var(--navy-900);
    border-bottom:1px solid var(--line);
    overflow:hidden;
    white-space:nowrap;
    position:sticky; top:0; z-index:20;
  }
  .ticker{display:inline-block; padding:9px 0; animation:scroll 26s linear infinite;}
  .ticker span{display:inline-block; padding:0 2.5rem; font-size:0.8rem; letter-spacing:0.08em; color:var(--ink-dim);}
  .ticker span b{color:var(--lime); font-weight:600;}
  @keyframes scroll{ from{transform:translateX(0);} to{transform:translateX(-50%);} }
  @media (prefers-reduced-motion:reduce){ .ticker{animation:none;} }

  /* Header / nav */
  header.site{
    display:flex; align-items:center; justify-content:space-between;
    padding:1.1rem clamp(1.2rem, 5vw, 3.5rem);
    border-bottom:1px solid var(--line);
  }
  .crest{display:flex; align-items:center; gap:0.7rem; font-family:'Rajdhani',sans-serif;}
  .crest-mark{
    width:38px; height:38px; border-radius:8px;
    background:linear-gradient(145deg, var(--cyan), var(--lime));
    display:flex; align-items:center; justify-content:center;
    font-weight:700; color:var(--navy-950); font-size:1.05rem;
  }
  .crest-name{font-weight:700; font-size:1.15rem; letter-spacing:0.04em;}
  .crest-sub{font-size:0.65rem; color:var(--ink-dim); letter-spacing:0.18em; margin-top:-2px;}

  /* Hero */
  .hero{
    position:relative;
    padding:clamp(3.5rem,9vw,6.5rem) clamp(1.2rem,5vw,3.5rem) clamp(2.5rem,6vw,4rem);
    text-align:center;
    overflow:hidden;
  }
  .hero::before{
    content:"";
    position:absolute; inset:0; z-index:-1;
    background-image:
      repeating-linear-gradient(0deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 64px);
    mask-image:radial-gradient(ellipse 70% 60% at 50% 20%, black, transparent 75%);
  }
  .eyebrow{
    display:inline-flex; align-items:center; gap:0.5rem;
    font-size:0.72rem; letter-spacing:0.22em; color:var(--lime);
    border:1px solid rgba(200,255,61,0.35); border-radius:999px;
    padding:0.35rem 0.9rem; margin-bottom:1.6rem;
  }
  .eyebrow::before{content:""; width:7px; height:7px; border-radius:50%; background:var(--lime); box-shadow:0 0 10px var(--lime);}
  .hero h1{
    font-size:clamp(2.6rem, 8vw, 5.2rem);
    line-height:0.98; font-weight:700; margin:0 0 1.1rem;
  }
  .hero h1 .accent{
    background:linear-gradient(100deg, var(--cyan), var(--lime));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero p.lede{
    max-width:640px; margin:0 auto 2.4rem; color:var(--ink-dim);
    font-size:1.05rem; line-height:1.6;
  }
  .cta-row{display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;}
  .btn{
    font-family:'Rajdhani',sans-serif; font-weight:700; letter-spacing:0.06em;
    text-transform:uppercase; font-size:0.95rem;
    padding:0.95rem 1.9rem; border-radius:10px;
    text-decoration:none; display:inline-flex; align-items:center; gap:0.5rem;
    transition:transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-primary{
    background:linear-gradient(100deg, var(--cyan), var(--lime));
    color:var(--navy-950);
    box-shadow:0 0 0 1px rgba(55,230,208,0.4), 0 12px 30px -12px rgba(55,230,208,0.55);
  }
  .btn-primary:hover{transform:translateY(-2px);}
  .btn-ghost{
    background:transparent; color:var(--ink);
    border:1px solid var(--line);
  }
  .btn-ghost:hover{border-color:var(--cyan); color:var(--cyan);}

  /* Scoreboard */
  .scoreboard{
    max-width:760px; margin:3.2rem auto 0;
    background:var(--navy-900); border:1px solid var(--line); border-radius:16px;
    padding:1.4rem clamp(1rem,4vw,2.2rem);
    display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:1rem;
  }
  .sb-team{display:flex; flex-direction:column; gap:0.3rem;}
  .sb-team.right{align-items:flex-end; text-align:right;}
  .sb-label{font-size:0.65rem; letter-spacing:0.16em; color:var(--ink-dim);}
  .sb-name{font-family:'Rajdhani',sans-serif; font-weight:700; font-size:1.15rem;}
  .sb-score{
    display:flex; align-items:center; gap:0.7rem;
    font-family:'Rajdhani',sans-serif; font-weight:700; font-size:2.2rem;
  }
  .sb-score .dash{color:var(--ink-dim); font-size:1.2rem;}
  .sb-status{
    grid-column:1/-1; text-align:center; font-size:0.72rem;
    color:var(--lime); letter-spacing:0.1em; margin-top:0.4rem;
    padding-top:0.9rem; border-top:1px dashed var(--line);
  }

  /* Stats strip */
  .stats{
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
    background:var(--line); border:1px solid var(--line); border-radius:16px;
    overflow:hidden; max-width:900px; margin:3rem auto 0;
  }
  .stat{background:var(--navy-900); padding:1.6rem 1rem; text-align:center;}
  .stat b{display:block; font-family:'Rajdhani',sans-serif; font-size:2rem; font-weight:700; color:var(--cyan);}
  .stat span{font-size:0.72rem; letter-spacing:0.12em; color:var(--ink-dim); text-transform:uppercase;}
  @media (max-width:640px){ .stats{grid-template-columns:repeat(2,1fr);} }

  /* Squad cards / sections nav */
  .section-nav{
    padding:clamp(2.5rem,6vw,4rem) clamp(1.2rem,5vw,3.5rem);
    max-width:1120px; margin:0 auto;
  }
  .section-nav h2{font-size:1.6rem; margin-bottom:0.3rem;}
  .section-nav .sub{color:var(--ink-dim); font-size:0.95rem; margin-bottom:2rem;}
  .card-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1.1rem;}
  .card{
    background:var(--navy-900); border:1px solid var(--line); border-radius:14px;
    padding:1.5rem; position:relative; overflow:hidden;
    transition:border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover{border-color:var(--cyan); transform:translateY(-3px);}
  .card .tag{
    font-size:0.65rem; letter-spacing:0.14em; color:var(--lime);
    text-transform:uppercase; margin-bottom:0.6rem; display:block;
  }
  .card h3{font-size:1.15rem; margin:0 0 0.5rem;}
  .card p{color:var(--ink-dim); font-size:0.88rem; line-height:1.55; margin:0 0 1.1rem;}
  .card a.link{
    font-size:0.82rem; font-weight:600; color:var(--cyan); text-decoration:none;
    display:inline-flex; align-items:center; gap:0.35rem;
  }
  .card a.link:hover{text-decoration:underline;}

  footer{
    border-top:1px solid var(--line); padding:2rem clamp(1.2rem,5vw,3.5rem);
    text-align:center; color:var(--ink-dim); font-size:0.82rem;
  }
</style>
</head>
<body>

  <div class="ticker-wrap" aria-hidden="true">
